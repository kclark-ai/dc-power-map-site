---
import '../styles/brand.css';
import '../styles/map.css';
import '../styles/workspace.css';
import DataCenterMap from '../components/DataCenterMap.tsx';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Compute Atlas — Kevin Clark</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="description" content="Explore US data centers, energy infrastructure, reported water sources, and average daily water use." />
    <meta property="og:title" content="Compute Atlas — Water, Power & Place" />
    <meta property="og:description" content="Explore US data centers, energy infrastructure, reported water sources, and average daily water use." />
    <meta property="og:image" content="https://map.kevinclark.ai/og-image.png" />
    <meta property="og:url" content="https://map.kevinclark.ai" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Compute Atlas — Water, Power & Place" />
    <meta name="twitter:description" content="Explore US data centers, energy infrastructure, reported water sources, and average daily water use." />
    <meta name="twitter:image" content="https://map.kevinclark.ai/og-image.png" />

  </head>
  <body class="gis-page">
    <a class="skip-link" href="#explorer">Skip to map</a>
    <main><section id="explorer" class="gis-explorer" aria-label="Interactive resource map"><div class="map-frame"><DataCenterMap client:only="react" /></div></section></main>
  </body>
</html>
