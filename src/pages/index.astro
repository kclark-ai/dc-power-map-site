---
import DataCenterMap from '../components/DataCenterMap.tsx';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>US Data Center Power Map</title>
    <meta name="description" content="Interactive map of US data centers and their electricity demand." />
    <meta property="og:title" content="US Data Center Power Map" />
    <meta property="og:description" content="Interactive map of US data centers and their electricity demand." />
    <meta property="og:image" content="https://map.kevinclark.ai/og-image.png" />
    <meta property="og:url" content="https://map.kevinclark.ai" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="US Data Center Power Map" />
    <meta name="twitter:description" content="Interactive map of US data centers and their electricity demand." />
    <meta name="twitter:image" content="https://map.kevinclark.ai/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 100%; height: 100%; background: #040e1f; }
      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: #1c3352; border-radius: 2px; }
    </style>
  </head>
  <body>
    <DataCenterMap client:only="react" />
  </body>
</html>
